{
  "manifest_version": 3,
  "name": "הקראה – קורא טקסט בקול טבעי",
  "short_name": "הקראה",
  "version": "1.0.0",
  "description": "מסמנים טקסט בכל אתר, לוחצים – והוא מוקרא בעברית בקול אנושי וטבעי. אפשר גם להקריא דף שלם או להדביק מאמר.",
  "minimum_chrome_version": "116",
  "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"},
  "action": {"default_title": "הקראה – סמן טקסט ולחץ כאן", "default_icon": {"16": "icon16.png", "48": "icon48.png"}},
  "background": {"service_worker": "background.js"},
  "side_panel": {"default_path": "reader.html"},
  "permissions": ["contextMenus", "sidePanel", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "commands": {
    "_execute_action": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "הקרא את הטקסט המסומן"}
  }
}
